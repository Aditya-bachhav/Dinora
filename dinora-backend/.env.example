# Backend runtime configuration
APP_NAME=Dinora Backend
DEBUG=true
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dinora
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Platform Razorpay fallback credentials (optional for local setup)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ENCRYPTION_KEY=your-fernet-encryption-key

# Cloudinary server credentials. Keep these only in dinora-backend/.env.
# Never add CLOUDINARY_API_SECRET to dinora-frontend/.env or expose it as VITE_*.

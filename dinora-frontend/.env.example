# Keep CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET in dinora-backend/.env instead.
VITE_CLOUDINARY_CLOUD_NAME=dtczjdk8l
VITE_CLOUDINARY_API_KEY=583943195433726
VITE_CLOUDINARY_API_SECRET=TZaefUcG8UkqyezCe71ib_TTT5Y
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_FOLDER=dinora/menu-items
